# Copy to .env and fill in (never commit .env)

# Optional: Java backend base URL when ready
VITE_API_BASE_URL=

# Groq — https://console.groq.com/keys (free tier)
VITE_GROQ_API_KEY=

# Optional model override (default: llama-3.3-70b-versatile)
# VITE_GROQ_MODEL=llama-3.3-70b-versatile

# EmailJS — https://www.emailjs.com/ (Public Key only in Vite; never Private Key)
# SERVICE_ID = Email Services səhifəsindəki ID (service_ ilə başlayır). Private Key BURAYA yazılmır.
# Şablon: To = {{to_email}}, mətn = {{report_text}} və ya Contact Us üçün {{message}}
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
